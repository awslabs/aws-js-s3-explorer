root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Makefile recipes must be indented with tabs
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = 4

[s3_id.txt]
insert_final_newline = false
